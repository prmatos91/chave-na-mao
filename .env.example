# Copie este arquivo para ".env" antes de subir o ambiente (docker compose up --build).
# Nenhum valor aqui e um segredo real - sao apenas defaults para rodar localmente.

# ---- PostgreSQL ----
POSTGRES_DB=crm_carros
POSTGRES_USER=crm_carros
POSTGRES_PASSWORD=change_me

# ---- Backend (Spring Boot) ----
# Porta exposta no host para a API.
BACKEND_PORT=8080
# Origem permitida pelo CORS do backend - deve bater com a porta do frontend abaixo.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---- Frontend (Angular servido via Nginx) ----
# Porta exposta no host para a aplicacao web.
FRONTEND_PORT=4200
# URL da API que sera usada pelo NAVEGADOR do usuario (nao e a rede interna do Docker,
# por isso deve ser localhost:BACKEND_PORT e nao o nome do servico "backend").
API_URL=http://localhost:8080
